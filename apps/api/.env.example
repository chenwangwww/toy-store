# 允许跨域访问后端的前端来源（逗号分隔，默认已包含 localhost:3000 / localhost:3001）
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 数据库连接串（当前 schema.prisma 直接写死了 file:./dev.db，
# 如需切换成 PostgreSQL/MySQL，把 schema.prisma 的 datasource 改成 env("DATABASE_URL") 即可）
# DATABASE_URL="file:./dev.db"

# JWT 密钥：至少 32 位，两个必须不同。生成方式：
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars