# 允许跨域访问后端的前端来源（逗号分隔，默认已包含 localhost:3000 / localhost:3001）
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 数据库连接串（当前 schema.prisma 直接写死了 file:./dev.db，
# 如需切换成 PostgreSQL/MySQL，把 schema.prisma 的 datasource 改成 env("DATABASE_URL") 即可）
# DATABASE_URL="file:./dev.db"

# JWT 密钥：至少 32 位，两个必须不同。生成方式：
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# ── 邮件服务（发送注册 / 找回密码验证码）────────────────────────────
# 不配置也能跑：验证码会打印在 api 进程的控制台，并回传给前端自动填入
# QQ 邮箱：设置 → 账户 → 开启 SMTP 服务 → 生成"授权码"（不是登录密码！）
# 163 邮箱：设置 → POP3/SMTP/IMAP → 开启服务 → 获取授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-account@qq.com
SMTP_PASS=这里填授权码，不是邮箱登录密码
SMTP_FROM=Toyland Express <your-account@qq.com>