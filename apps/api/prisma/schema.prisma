// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 用户表
model User {
  id        String   @id @default(uuid())
  username  String
  email     String   @unique
  password  String   // 实际场景保存哈希加密密码
  phone     String?
  avatar    String?
  isAdmin   Boolean  @default(false)
  orders    Order[]
  refreshTokens RefreshToken[]
  bannedAt     DateTime?   // null 表示正常，非空表示封禁时间
  bannedReason String?
  createdAt DateTime @default(now())
}

// 玩具商品表
model Toy {
  id            String      @id @default(uuid())
  name          String
  price         Float
  originalPrice Float?
  category      String
  ageRange      String
  rating        Float       @default(5.0)
  sales         Int         @default(0)
  image         String
  description   String
  stock         Int         @default(100)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
}

// 订单主表
model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Float
  status      String      @default("PAID") // PAID, SHIPPED, COMPLETED, CANCELLED
  items       OrderItem[]
  createdAt   DateTime    @default(now())
}

// 订单明细表
model OrderItem {
  id       String @id @default(uuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id])
  toyId    String
  toy      Toy    @relation(fields: [toyId], references: [id])
  quantity Int
  price    Float  // 下单时的单价
}

// 刷新令牌表：一条记录 = 一个已签发的 refresh token
// id 就是 JWT 里的 jti，退出登录 / 轮换时按 id 作废
model RefreshToken {
  id        String    @id              // = jti（uuid）
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?                  // 非空表示已作废
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 邮箱验证码：注册验证 / 找回密码共用一张表
// SQLite 不支持 enum，purpose 用字符串 + 注释约定取值
model EmailCode {
  id         String    @id @default(uuid())
  email      String    // 收件邮箱
  code       String    // 6 位数字，明文存（见 10.2 的取舍说明）
  purpose    String    // 'register' | 'reset'
  expiresAt  DateTime  // 过期时间
  consumedAt DateTime? // 非空 = 已使用或已作废，不能再校验
  attempts   Int       @default(0) // 校验失败次数，达到上限直接作废
  createdAt  DateTime  @default(now())

  // 每次发码/校验都是按 email + purpose 查最近一条，这个联合索引刚好命中
  @@index([email, purpose, createdAt])
}