{
  "name": "toy-store",
  "version": "0.1.0",
  "private": true,
  "description": "Toyland Express 玩具商城 —— 后端 / C端 / 管理后台 三端分离的 monorepo",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @toy-store/api dev",
    "dev:web": "pnpm --filter @toy-store/web dev",
    "dev:admin": "pnpm --filter @toy-store/admin dev",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @toy-store/api build",
    "build:web": "pnpm --filter @toy-store/web build",
    "build:admin": "pnpm --filter @toy-store/admin build",
    "start:api": "pnpm --filter @toy-store/api start",
    "start:web": "pnpm --filter @toy-store/web start",
    "start:admin": "pnpm --filter @toy-store/admin start",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @toy-store/api prisma:generate",
    "db:push": "pnpm --filter @toy-store/api prisma:push",
    "db:migrate": "pnpm --filter @toy-store/api prisma:migrate",
    "db:seed": "pnpm --filter @toy-store/api prisma:seed",
    "db:studio": "pnpm --filter @toy-store/api prisma:studio"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  }
}
